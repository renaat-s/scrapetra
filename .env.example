SCRAPETRA_SENDER_NAME=ScrapeTra Lead Agent

# === DOMAIN ===
SCRAPETRA_ALLOWED_ORIGINS=https://www.scrapetra.com,https://scrapetra.com
SCRAPETRA_BASE_URL=https://www.scrapetra.com

# === OPTIONAL (PayPal — skip if not using) ===
